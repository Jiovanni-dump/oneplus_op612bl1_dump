service vendor.qti.light /vendor/bin/hw/vendor.qti.hardware.lights.service
    class hal
    user system
    group system
    shutdown critical

on boot
    mkdir /data/vendor/liblight 0771 system system
    chmod 0777 /data/vendor/liblight/oplusLights.xml
    chown system system /sys/class/leds/red/br
    chown system system /sys/class/leds/red/brightness
    chown system system /sys/class/leds/red/color
    chown system system /sys/class/leds/red/color_ratio
    chown system system /sys/class/leds/red/effect
    chown system system /sys/class/leds/red/hwen
    chown system system /sys/class/leds/red/led_num
    chown system system /sys/class/leds/red/max_brightness
    chown system system /sys/class/leds/red/opdetect
    chown system system /sys/class/leds/red/power
    chown system system /sys/class/leds/red/reg
    chown system system /sys/class/leds/red/rgbcolor
    chown system system /sys/class/leds/red/singleled
    chown system system /sys/class/leds/red/stdetect
    chown system system /sys/class/leds/red/support
    chown system system /sys/class/leds/red/tf1
    chown system system /sys/class/leds/red/toff
    chown system system /sys/class/leds/red/tr1
    chown system system /sys/class/leds/red/ton
    chown system system /sys/class/leds/red/trigger
    chown system system /sys/class/leds/red/l_type
    chown system system /sys/class/leds/red/effectdata
    chown system system /sys/class/leds/red/light_sensor
