service bsp_ddr_vcorefs_aging /odm/bin/init.oplus.bsp_ddr_vcorefs.sh
    class core
    user root
    group root system log
    stdio_to_kmsg
    disabled
    oneshot

service mm_quick_test /system_ext/bin/mm_quick_test_q.sh
    class core
    user root
    group root system log
    stdio_to_kmsg
    disabled
    oneshot

on property:sys.is_aging_test.enable=1
    start bsp_ddr_vcorefs_aging

on property:sys.is_aging_test.enable=0
    stop bsp_ddr_vcorefs_aging

on property:sys.is_aging_test.enable=5
    start mm_quick_test

on property:sys.is_aging_test.enable=4
    stop mm_quick_test

